# Secrets: ONLY .sops.env and .sops.yaml files are committable (encrypted). Anything
# else resembling plaintext config or key material inside secrets/ is paranoia-ignored.
secrets/*.env
!secrets/*.sops.env
secrets/*.yaml
secrets/*.yml
!secrets/*.sops.yaml
secrets/*.key
secrets/*.txt
secrets/*.json
!secrets/*.sops.json

# Unencrypted secret / credential material (repo-wide)
# Env files (allow only .example variants)
.env
.env.*
!.env.example
!.env.*.example
*.env.local
