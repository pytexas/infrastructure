# Copy to .env (gitignored) on the droplet. Each variable is read by the master compose
# and by Caddy at start time.

# Tailscale hostname the Temporal dev server registers as on the tailnet.
TS_HOSTNAME=pytexas-temporal

# Tailscale credential used by temporal-ts-net to bring the container onto the tailnet.
# Current image: a plain auth key (tskey-auth-...), reusable + pre-approved + tag:pytexas.
# Generate at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-REPLACE_ME

# STAGED: once temporal-ts-net supports tsnet ClientSecret, set this to a Tailscale OAuth
# client secret (tskey-client-...) and drop TS_AUTHKEY above. OAuth clients never expire and
# tagged nodes don't expire, so the container self-authenticates forever with no rotation.
# Create an OAuth client (auth_keys scope, tag:pytexas) at
# https://login.tailscale.com/admin/settings/oauth
# TS_CLIENT_SECRET=tskey-client-REPLACE_ME

# Public hostname for the dispatch web service.
MIDDLEWARE_DOMAIN=middleware.pytexas.org
