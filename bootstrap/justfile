# ABOUTME: Laptop-side bootstrap and deploy recipes for the PyTexas infra repo.
# Run from this directory (`cd bootstrap && just apply`) or from the repo root
# with `--working-directory` (`just -d bootstrap apply`). Recipes resolve paths
# from the repo root via {{repo_root}}.
#
# For day-2 service control (start/stop/logs/pull), see ../justfile -- meant to
# run on the droplet, not here.

repo_root := justfile_directory() / ".."

default:
    @just --list

# Full deploy: terraform apply + ansible playbook. Idempotent.
apply: (_tf "apply -auto-approve") _ansible

# Preview terraform changes.
plan:
    @just _tf plan

# Tear everything down (droplet, firewall, DNS, project). State lives in
# terraform/state.sops.json in this repo, so there's nothing to migrate first.
# To just rebuild the droplet instead, use `just rebuild`.
destroy:
    @just _tf destroy

# Print the droplet's public IPv4 from terraform state.
ip:
    @just _tf 'output -raw droplet_ipv4'

# Replace the droplet from scratch, keeping state and DNS.
# Use this to "start the droplet over" without a full destroy.
# Follow with `just apply` to re-run ansible against the new droplet.
rebuild: (_tf "apply -auto-approve -replace=digitalocean_droplet.main")

# Create or edit a sops-encrypted file.
# Example: just sops secrets/pytexas.sops.env
sops file:
    cd "{{repo_root}}" && sops {{file}}

# Re-encrypt every secrets file with the current recipient list in .sops.yaml.
# Run after adding or removing an age key recipient.
rekey:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{repo_root}}"
    shopt -s nullglob
    files=(secrets/*.sops.env secrets/*.sops.yaml terraform/*.sops.json)
    if [ ${#files[@]} -eq 0 ]; then echo "No secrets files yet."; exit 0; fi
    for f in "${files[@]}"; do
        echo "rekey: $f"
        sops updatekeys -y "$f"
    done

# Install ansible collections required by the playbook. Run once after `git clone`.
setup:
    cd "{{repo_root}}/ansible" && ansible-galaxy collection install -r requirements.yml

# Format + validate terraform.
lint:
    cd "{{repo_root}}/terraform" && terraform fmt -recursive && terraform validate

# === Internal helpers ======================================================

# Run a terraform command with state decrypted from terraform/state.sops.json.
# State lives encrypted-at-rest in git (no remote backend): decrypt it into
# terraform's working file, run the command, then re-encrypt IN PLACE only if the
# state actually changed (so read-only commands don't churn git, and a fresh sops
# nonce isn't written on every plan). Re-encryption also runs when terraform exits
# non-zero, so a partial apply's state is never lost. Commit the file afterward.
_tf cmd:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{repo_root}}"
    enc=terraform/state.sops.json
    plain=terraform/terraform.tfstate
    pre="$plain.pre"
    if [ -f "$enc" ]; then
        sops --decrypt --output-type binary "$enc" > "$plain"
        cp -f "$plain" "$pre"
    else
        : > "$pre"
    fi
    ( cd terraform && sops exec-env ../secrets/terraform.sops.env "terraform {{cmd}}" ) && rc=0 || rc=$?
    if [ -f "$plain" ] && ! cmp -s "$plain" "$pre"; then
        cp -f "$plain" "$enc"
        sops --encrypt --input-type binary --output-type json -i "$enc"
        echo ">> terraform state changed -- re-encrypted $enc. Commit it: git add $enc && git commit" >&2
    fi
    rm -f "$pre"
    exit $rc

_ansible:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{repo_root}}"
    # `terraform output` needs the state on disk; decrypt it (read-only, no re-encrypt).
    [ -f terraform/state.sops.json ] && sops --decrypt --output-type binary terraform/state.sops.json > terraform/terraform.tfstate
    ip=$(cd terraform && sops exec-env ../secrets/terraform.sops.env 'terraform output -raw droplet_ipv4')
    sed "s/REPLACE_WITH_DROPLET_IPV4/$ip/" ansible/inventory.yml > ansible/inventory.local.yml
    # Pick the SSH user: the deploy user (pytexas) on an already-hardened droplet,
    # root on a fresh one. The bootstrap role disables root login and creates the
    # deploy user on first run, so re-applying as root fails afterward. Probe pytexas
    # first (the common day-2 case) to avoid a needless failed root auth against fail2ban.
    ssh_opts="-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
    if ssh $ssh_opts "pytexas@$ip" true 2>/dev/null; then
        user=pytexas
    elif ssh $ssh_opts "root@$ip" true 2>/dev/null; then
        user=root
    else
        echo "error: cannot SSH to $ip as pytexas or root -- check the droplet is up and your key is loaded (ssh-add -l)" >&2
        exit 1
    fi
    echo "ansible: connecting as $user@$ip"
    cd ansible && ansible-playbook -i inventory.local.yml -e ansible_user="$user" playbook.yml
